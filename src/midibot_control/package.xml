<?xml version="1.0"?>
<package format="3">
  <name>midibot_control</name>
  <version>0.1.0</version>
  <description>MIDIBOT control nodes (Locomotion &amp; Movement Unit): hand coupler, later walking/balance.</description>
  <maintainer email="midyadebangshu@gmail.com">MIDIBOT team</maintainer>
  <license>Proprietary</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>midibot_description</exec_depend>
  <exec_depend>midibot_locomotion</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
